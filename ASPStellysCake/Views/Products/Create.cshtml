


@model ASPStellysCake.Models.Product
@{
    ViewData["Title"] = "Добави продукт";
    bool hasCategories = ViewBag.HasCategories ?? false;
    var categories = ViewBag.Categories as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                     ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="section-header">
    <h1 class="section-title">Добави нов продукт</h1>
    <a asp-action="Index" asp-route-categoryId="2" class="btn-ghost">← Обратно</a>
</div>

@if (!hasCategories)
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-4" role="alert">
        <span style="font-size:1.3rem">⚠️</span>
        <div>
            <strong>Няма налични категории!</strong>
            Преди да добавите продукт, трябва да създадете поне една категория.
            <a asp-controller="Categories" asp-action="Create" class="btn-pink ms-2" style="font-size:0.85rem; padding:5px 14px;">
                + Добави категория
            </a>
        </div>
    </div>
}

<div class="form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()

        <div asp-validation-summary="All" class="alert alert-danger mb-3" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Наименование</label>
            <input asp-for="Name" class="form-control" placeholder="Напр. Шоколадова торта" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Каталожен номер <span class="text-muted fw-normal">(незадължително)</span></label>
            <input asp-for="CatNumber" class="form-control" placeholder="Напр. CAT-001" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Категория</label>
            @if (!hasCategories)
            {
                <div class="form-control text-muted" style="background:#f8f9fa;">
                    Няма категории — първо добавете категория
                </div>
                <input type="hidden" name="CategoryId" value="0" />
            }
            else
            {
                <select asp-for="CategoryId" class="form-select" asp-items="categories">
                    <option value="0">-- Изберете категория --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger small"></span>
            }
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Тегло (кг)</label>
            <input asp-for="Weight" class="form-control" type="number" step="0.1" min="0" placeholder="Напр. 1.5" />
            <span asp-validation-for="Weight" class="text-danger small"></span>
        </div>

        <div class="mb-3 form-check">
            <input asp-for="GlutenFree" class="form-check-input" type="checkbox" />
            <label class="form-check-label">Без глутен</label>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Описание <span class="text-muted fw-normal">(незадължително)</span></label>
            <input asp-for="Description" class="form-control" placeholder="Кратко описание на тортата" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">URL на снимка <span class="text-muted fw-normal">(незадължително)</span></label>
            <input asp-for="ImageURL" class="form-control" placeholder="https://example.com/image.jpg" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Цена (лв.)</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="Напр. 45.00" />
            <span asp-validation-for="Price" class="text-danger small"></span>
        </div>

        <div class="mt-4 d-flex gap-3">
            @if (hasCategories)
            {
                <button type="submit" class="btn-pink">✅ Добави продукт</button>
            }
            else
            {
                <button type="button" class="btn-pink" disabled>✅ Добави продукт</button>
            }
            <a asp-action="Index" asp-route-categoryId="2" class="btn-ghost">Отказ</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}