
@model ASPStellysCake.Models.Product
@{
    ViewData["Title"] = "Изтрий продукт";
}

<div class="section-header">
    <h1 class="section-title">Потвърди изтриване</h1>
</div>

<div class="details-card" style="max-width:500px;">
    <div style="display:flex;align-items:center;gap:12px;padding:16px;background:var(--rose-50);border-radius:var(--radius);border:1px solid var(--rose-100);margin-bottom:24px;">
        <span style="font-size:1.8rem;">⚠️</span>
        <div>
            <div style="font-weight:600;">Изтриване на „@Model.Name"</div>
            <div style="font-size:0.85rem;color:var(--neutral-500);">Това действие е необратимо.</div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-4">
            <img src="@Model.ImageURL" alt="@Model.Name" style="width:100%;border-radius:var(--radius);object-fit:cover;aspect-ratio:1;"
                 onerror="this.src='/images/logo.png'" />
        </div>
        <div class="col-8">
            <div class="detail-row"><span class="detail-label">Категория</span><span class="detail-value">@Model.Categories?.Name</span></div>
            <div class="detail-row"><span class="detail-label">Тегло</span><span class="detail-value">@Model.Weight кг</span></div>
            <div class="detail-row" style="border-bottom:none;"><span class="detail-label">Цена</span><span class="detail-value" style="font-weight:700;color:var(--rose-600);">@Model.Price.ToString("F2") лв.</span></div>
        </div>
    </div>

    <form asp-action="Delete" asp-route-categoryId="@ViewBag.CategoryId" class="d-flex gap-3">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn-danger-sm" style="font-size:0.92rem;padding:10px 20px;">🗑 Да, изтрий</button>
        <a asp-action="Index" asp-route-categoryId="@ViewBag.CategoryId" class="btn-ghost">Отказ</a>
    </form>
</div>
