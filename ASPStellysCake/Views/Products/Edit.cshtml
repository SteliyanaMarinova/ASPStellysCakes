


@model ASPStellysCake.Models.Product
@{
    ViewData["Title"] = "Редактирай продукт";
    var categories = ViewBag.Categories as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                     ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="section-header">
    <h1 class="section-title">Редактиране: @Model.Name</h1>
    <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn-ghost">← Обратно</a>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div asp-validation-summary="All" class="alert alert-danger mb-3" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Наименование</label>
            <input asp-for="Name" class="form-control" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Каталожен номер</label>
            <input asp-for="CatNumber" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Категория</label>
            <select asp-for="CategoryId" class="form-select" asp-items="categories">
                <option value="0">-- Изберете категория --</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Тегло (кг)</label>
            <input asp-for="Weight" class="form-control" type="number" step="0.1" min="0" />
        </div>

        <div class="mb-3 form-check">
            <input asp-for="GlutenFree" class="form-check-input" type="checkbox" />
            <label class="form-check-label">Без глутен</label>
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Описание</label>
            <input asp-for="Description" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">URL на снимка</label>
            <input asp-for="ImageURL" class="form-control" />
        </div>

        <div class="mb-3">
            <label class="form-label fw-semibold">Цена (лв.)</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" />
            <span asp-validation-for="Price" class="text-danger small"></span>
        </div>

        <div class="mt-4 d-flex gap-3">
            <button type="submit" class="btn-pink">💾 Запази промените</button>
            <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn-ghost">Отказ</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

