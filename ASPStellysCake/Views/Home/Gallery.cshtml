    <div class="gallery-sidebar">
        <h4>Филтри</h4>
        <label class="filter-label">
            <input type="checkbox" value="clasic" checked onchange="filterGallery()" /> Класически
        </label>
        <label class="filter-label">
            <input type="checkbox" value="povod" checked onchange="filterGallery()" /> За повод
        </label>
        <label class="filter-label">
            <input type="checkbox" value="glutenfree" checked onchange="filterGallery()" /> Без глутен
        </label>
    </div>
