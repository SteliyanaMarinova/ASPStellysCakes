@model ErrorViewModel

@{
    ViewData["Title"] = "Грешка";
}

<h1 class="text-danger">Грешка.</h1>

<h2 class="text-danger">
    Възникна грешка при обработката на вашата заявка.
</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID на заявката:</strong>
        <code>@Model.RequestId</code>
    </p>
}

<h3>Режим за разработка</h3>

<p>
    Превключването към среда <strong>Development</strong>
    ще покаже по-подробна информация за възникналата грешка.
</p>

<p>
    <strong>
        Режимът Development не трябва да бъде активиран
        в публикувани приложения.
    </strong>

    Това може да доведе до показване на чувствителна информация
    за грешките към крайните потребители.
</p>

<p>
    За локално дебъгване активирайте средата
    <strong>Development</strong>, като зададете
    променливата
    <strong>ASPNETCORE_ENVIRONMENT</strong>
    на <strong>Development</strong>
    и рестартирате приложението.
</p>
