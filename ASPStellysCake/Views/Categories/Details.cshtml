@model ASPStellysCake.Models.Category
@{ ViewData["Title"] = Model.Name ?? "Категория"; }
<div class="section-header">
    <h1 class="section-title">@Model.Name</h1>
    <a asp-action="Index" class="btn-ghost">← Обратно</a>
</div>
<div class="details-card" style="max-width:480px;">
    <div class="detail-row"><span class="detail-label">Наименование</span><span class="detail-value">@Model.Name</span></div>
    <div class="detail-row"><span class="detail-label">Описание</span><span class="detail-value">@Model.Description</span></div>
    <div class="detail-row" style="border-bottom:none;"><span class="detail-label">Дата</span><span class="detail-value">@Model.RegisterOn.ToString("dd.MM.yyyy")</span></div>
    <div class="mt-4">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-ghost">✏️ Редактирай</a>
    </div>
</div>

