@model ASPStellysCake.Models.Category
@{
    ViewData["Title"] = "Нова категория";
}
<div class="section-header">
    <h1 class="section-title">Нова категория</h1>
    <a asp-action="Index" class="btn-ghost">← Обратно</a>
</div>
<div class="form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
        <div class="mb-3">
            <label class="form-label">Наименование</label>
            <input asp-for="Name" class="form-control" placeholder="Напр. Класически торти" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label">Описание</label>
            <input asp-for="Description" class="form-control" placeholder="Кратко описание" />
        </div>
        <div class="mt-4 d-flex gap-3">
            <button type="submit" class="btn-pink">✅ Добави</button>
            <a asp-action="Index" class="btn-ghost">Отказ</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}