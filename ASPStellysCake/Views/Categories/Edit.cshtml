@model ASPStellysCake.Models.Category
@{
    ViewData["Title"] = "Редактирай категория";
}
<div class="section-header">
    <h1 class="section-title">Редактиране: @Model.Name</h1>
    <a asp-action="Index" class="btn-ghost">← Обратно</a>
</div>
<div class="form-card">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
        <div class="mb-3">
            <label class="form-label">Наименование</label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Описание</label>
            <input asp-for="Description" class="form-control" />
        </div>
        <div class="mt-4 d-flex gap-3">
            <button type="submit" class="btn-pink">💾 Запази</button>
            <a asp-action="Index" class="btn-ghost">Отказ</a>
        </div>
    </form>
</div>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
