@model IEnumerable<ASPStellysCake.Models.Category>
@{
    ViewData["Title"] = "Категории";
}

<div class="section-header">
    <h1 class="section-title">Категории</h1>
    <a asp-action="Create" class="btn-create">+ Нова категория</a>
</div>

<div class="data-table-wrapper">
    <table class="data-table">
        <thead>
            <tr>
                <th>#</th>
                <th>Наименование</th>
                <th>Описание</th>
                <th>Дата</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td style="color:var(--neutral-400);font-size:0.8rem;">@item.Id</td>
                    <td><strong>@item.Name</strong></td>
                    <td style="color:var(--neutral-500);">@item.Description</td>
                    <td style="font-size:0.82rem;color:var(--neutral-400);">@item.RegisterOn.ToString("dd.MM.yyyy")</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn-ghost" style="font-size:0.82rem;padding:6px 12px;">✏️ Редактирай</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn-ghost" style="font-size:0.82rem;padding:6px 12px;">👁</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn-danger-sm" style="font-size:0.82rem;padding:6px 12px;">🗑</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
