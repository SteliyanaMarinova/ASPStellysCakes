

@model ASPStellysCake.Models.Order
@{
    ViewData["Title"] = "Редактирай поръчка";
}

<div class="section-header">
    <h1 class="section-title">Редактиране на поръчка <span style="color:var(--rose-600);">#@Model.Id</span></h1>
    <a asp-action="Index" class="btn-ghost">← Обратно</a>
</div>

<div class="form-card">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

        <div class="mb-3">
            <label class="form-label">Клиент</label>
            <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.CustomerId"></select>
        </div>
        <div class="mb-3">
            <label class="form-label">Продукт</label>
            <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductId"></select>
        </div>
        <div class="mb-3">
            <label class="form-label">Брой</label>
            <input asp-for="Quantity" class="form-control" type="number" min="1" />
            <span asp-validation-for="Quantity" class="text-danger small"></span>
        </div>
        <div class="mt-4 d-flex gap-3">
            <button type="submit" class="btn-pink">💾 Запази</button>
            <a asp-action="Index" class="btn-ghost">Отказ</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
