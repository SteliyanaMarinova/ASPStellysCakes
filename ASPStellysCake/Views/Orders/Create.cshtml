
@model ASPStellysCake.Models.Order
@{
    ViewData["Title"] = "Нова поръчка";
}

<div class="section-header">
    <h1 class="section-title">Нова поръчка</h1>
    <a asp-action="Index" class="btn-ghost">← Обратно</a>
</div>

<div class="form-card">
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>
        <div class="mb-3">
            <label class="form-label">Продукт</label>
            <select asp-for="ProductId" class="form-select" asp-items="ViewBag.ProductId">
                <option value="">-- Изберете продукт --</option>
            </select>
        </div>
        <div class="mb-3">
            <label class="form-label">Брой</label>
            <input asp-for="Quantity" class="form-control" type="number" min="1" max="99" value="1" />
            <span asp-validation-for="Quantity" class="text-danger small"></span>
        </div>
        <div class="mt-4 d-flex gap-3">
            <button type="submit" class="btn-pink">✅ Поръчай</button>
            <a asp-action="Index" class="btn-ghost">Отказ</a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
