

@model IEnumerable<ASPStellysCake.Models.Order>
@{
    ViewData["Title"] = User.IsInRole("Admin") ? "Всички поръчки" : "Моите поръчки";
    decimal grandTotal = Model.Sum(o => o.Products != null ? o.Products.Price * o.Quantity : 0);
}

<div class="section-header">
    <h1 class="section-title">@ViewData["Title"]</h1>
    @if (User.IsInRole("Customer"))
    {
        <a asp-controller="Cart" asp-action="Index" class="btn-pink">🛒 Количка</a>
    }
</div>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">📋</div>
        <p>Няма направени поръчки.</p>
        @if (User.IsInRole("Customer"))
        {
            <a asp-controller="Products" asp-action="Index" asp-route-categoryId="2" class="btn-pink">Разгледай тортите</a>
        }
    </div>
}
else
{
    <div class="data-table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th>Клиент</th>
                    }
                    <th>Продукт</th>
                    <th>Ед. цена</th>
                    <th>Брой</th>
                    <th>Общо</th>
                    <th>Дата</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td style="color:var(--neutral-400);font-size:0.8rem;">#@item.Id</td>
                        @if (User.IsInRole("Admin"))
                        {
                            <td>
                                <span style="font-weight:600;">@item.Customers?.UserName</span>
                                <div style="font-size:0.78rem;color:var(--neutral-400);">@item.Customers?.Email</div>
                            </td>
                        }
                        <td><span style="font-weight:600;">@item.Products?.Name</span></td>
                        <td>@item.Products?.Price.ToString("F2") лв.</td>
                        <td>
                            <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:50%;background:var(--rose-100);color:var(--rose-700);font-weight:700;font-size:0.85rem;">
                                @item.Quantity
                            </span>
                        </td>
                        <td><span class="total-chip">@((item.Products != null ? item.Products.Price * item.Quantity : 0).ToString("F2")) лв.</span></td>
                        <td style="font-size:0.82rem;color:var(--neutral-500);">@item.RegisterOn.ToString("dd.MM.yyyy")<br /><span style="font-size:0.75rem;">@item.RegisterOn.ToString("HH:mm")</span></td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn-ghost" style="font-size:0.8rem;padding:5px 10px;">👁</a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn-ghost" style="font-size:0.8rem;padding:5px 10px;">✏️</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-danger-sm" style="font-size:0.8rem;padding:5px 10px;">🗑</a>
                                }
                                else
                                {
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn-danger-sm" style="font-size:0.8rem;padding:5px 10px;">✕</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <td colspan="@(User.IsInRole("Admin") ? 5 : 4)" style="text-align:right;color:var(--neutral-600);">Обща сума:</td>
                    <td colspan="3" style="color:var(--rose-700);font-size:1.05rem;">@grandTotal.ToString("F2") лв.</td>
                </tr>
            </tfoot>
        </table>
    </div>
    }
