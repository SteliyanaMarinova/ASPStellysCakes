

@model ASPStellysCake.Models.Order
@{
    ViewData["Title"] = "Откажи поръчка";
    decimal lineTotal = Model.Products != null ? Model.Products.Price * Model.Quantity : 0;
}

<div class="section-header">
    <h1 class="section-title">Потвърди отказ</h1>
</div>

<div class="details-card" style="max-width:500px;">
    <div style="display:flex;align-items:center;gap:12px;padding:16px;background:var(--rose-50);border-radius:var(--radius);border:1px solid var(--rose-100);margin-bottom:24px;">
        <span style="font-size:1.8rem;">⚠️</span>
        <div>
            <div style="font-weight:600;color:var(--neutral-900);">Сигурни ли сте?</div>
            <div style="font-size:0.85rem;color:var(--neutral-500);">Тази поръчка ще бъде изтрита безвъзвратно.</div>
        </div>
    </div>

    <div class="detail-row">
        <span class="detail-label">Продукт</span>
        <span class="detail-value" style="font-weight:600;">@Model.Products?.Name</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Количество</span>
        <span class="detail-value">@Model.Quantity бр.</span>
    </div>
    <div class="detail-row">
        <span class="detail-label">Обща сума</span>
        <span class="detail-value" style="font-weight:700;color:var(--rose-600);">@lineTotal.ToString("F2") лв.</span>
    </div>
    <div class="detail-row" style="border-bottom:none;">
        <span class="detail-label">Дата</span>
        <span class="detail-value">@Model.RegisterOn.ToString("dd.MM.yyyy HH:mm")</span>
    </div>

    <div class="d-flex gap-3 mt-4">
        <form asp-action="Delete">
            <button type="submit" class="btn-danger-sm" style="font-size:0.92rem;padding:9px 20px;">🗑 Да, изтрий</button>
        </form>
        <a asp-action="Index" class="btn-ghost">Отказ</a>
    </div>
</div>